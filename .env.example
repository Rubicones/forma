ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# DATA_DIR=/absolute/path/to/forma-data
PORT=4317
PREVIEW_PORT=4318
CODEX_API_KEY=
# CODEX_BIN=/absolute/path/to/codex

# Image/video generation for the model (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Images: Nano Banana 2 at 2K (about $0.10 an image; the Lite tier is cheaper but fits objects badly).
# Video: MiniMax H3 Max at 768p (about $0.08 a second, 5–15 s clips, first and last frame; 480p is about $0.05 a second).
# minimax/hailuo-3 is 2K only at about $0.13 a second and takes minutes. For production quality try openai/gpt-image-2 and google/veo-3.1.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_IMAGE_RESOLUTION=2K
OPENROUTER_VIDEO_MODEL=minimax/hailuo-3-max
OPENROUTER_VIDEO_RESOLUTION=768p
# MEDIA_MAX_IMAGES=8
# MEDIA_MAX_VIDEOS=2

# API list prices for models without a built-in price (USD per 1M tokens), used for cost estimates
# PRICING_JSON={"custom-model":{"input":2,"output":10,"cacheRead":0.2}}

# Store: file (local data/) or supabase (Supabase Postgres + Cloudflare R2, shared with colleagues)
FORMA_STORE=file
FORMA_AUTHOR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=forma
# Optional: local cache dir in cloud mode (defaults to DATA_DIR)
# CACHE_DIR=

# The art director's look renders previews and finals in headless Chrome (puppeteer-core).
# Found automatically on macOS (Google Chrome, Chromium, Edge, Brave) and at /usr/bin/chromium on Linux.
# In Docker install chromium and point to it if it lives elsewhere:
# FORMA_CHROME=/usr/bin/chromium

# "Read Figma" on the brand page: a personal access token (scope file_content:read) from the studio's Figma account.
# Figma's API limits depend on the seat: a Dev or Full seat on a paid plan (Professional is enough) reads freely.
FIGMA_TOKEN=

# Exports of finals for the client (export.mjs): ffmpeg comes with npm install (ffmpeg-static); point FORMA_FFMPEG
# at another binary if needed. FORMA_EXPORTS=0 stops this Forma from exporting (e.g. when another one does).
FORMA_FFMPEG=
FORMA_EXPORTS=
