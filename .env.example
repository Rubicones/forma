ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# DATA_DIR=/absolute/path/to/forma-data
PORT=4317
PREVIEW_PORT=4318
CODEX_API_KEY=
# CODEX_BIN=/absolute/path/to/codex

# Image/video generation for the model (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Cheap test defaults: Nano Banana 2 Lite for images, Grok Imagine 1.5 Lite at 480p for video.
# For production quality try openai/gpt-image-2 (supports transparent cutouts) and google/veo-3.1 at 1080p.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image
OPENROUTER_IMAGE_RESOLUTION=1K
OPENROUTER_VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite
OPENROUTER_VIDEO_RESOLUTION=480p
# MEDIA_MAX_IMAGES=8
# MEDIA_MAX_VIDEOS=2

# API list prices for models without a built-in price (USD per 1M tokens), used for cost estimates
# PRICING_JSON={"custom-model":{"input":2,"output":10,"cacheRead":0.2}}

# Store: file (local data/) or supabase (Supabase Postgres + Cloudflare R2, shared with colleagues)
FORMA_STORE=file
FORMA_AUTHOR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=forma
# Optional: local cache dir in cloud mode (defaults to DATA_DIR)
# CACHE_DIR=
