ANTHROPIC_API_KEY=
# CLAUDE_MODEL=
# DATA_DIR=/absolute/path/to/forma-data
PORT=4317
PREVIEW_PORT=4318
CODEX_API_KEY=
# CODEX_BIN=/absolute/path/to/codex

# Image/video generation for the model (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
# Images: Nano Banana 2 at 2K (about $0.10 an image; the Lite tier is cheaper but fits objects badly). Video: Grok Imagine 1.5 Lite at 480p.
# For production quality try openai/gpt-image-2 (supports transparent cutouts) and google/veo-3.1 at 1080p.
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_IMAGE_RESOLUTION=2K
OPENROUTER_VIDEO_MODEL=x-ai/grok-imagine-video-1.5-lite
OPENROUTER_VIDEO_RESOLUTION=480p
# MEDIA_MAX_IMAGES=8
# MEDIA_MAX_VIDEOS=2

# API list prices for models without a built-in price (USD per 1M tokens), used for cost estimates
# PRICING_JSON={"custom-model":{"input":2,"output":10,"cacheRead":0.2}}

# Store: file (local data/) or supabase (Supabase Postgres + Cloudflare R2, shared with colleagues)
FORMA_STORE=file
FORMA_AUTHOR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=forma
# Optional: local cache dir in cloud mode (defaults to DATA_DIR)
# CACHE_DIR=

# The art director's look renders previews and finals in headless Chrome (puppeteer-core).
# Found automatically on macOS (Google Chrome, Chromium, Edge, Brave) and at /usr/bin/chromium on Linux.
# In Docker install chromium and point to it if it lives elsewhere:
# FORMA_CHROME=/usr/bin/chromium
