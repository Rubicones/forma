    "@supabase/supabase-js": "^2.119.0",
    "express": "5.3.0",
    "gsap": "3.15.1",
    "lottie-web": "5.13.0",
    "puppeteer-core": "25.18.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  }
