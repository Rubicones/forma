{
  "$description": "Toggle Concepts design tokens v1.0 (3 Nov 2026). Source: concepts.toggle.studio and brandbook.md.",
  "color": {
    "navy": { "value": "#0C2B3F", "role": "ink: text, logo, dark tiles, buttons" },
    "white": { "value": "#FFFFFF", "role": "paper: background, text on navy" },
    "sky": { "value": "#B4E4FA", "role": "highlight tiles, selected states" },
    "orange": { "value": "#FF4F17", "role": "accent: one key word, offer, progress; large text and graphics only" },
    "gray": { "value": "#F1F1F1", "role": "neutral tiles" },
    "muted": { "value": "#5A6B78", "role": "secondary text on light" },
    "mist": { "value": "#BFD3E0", "role": "secondary text on navy" },
    "line": { "value": "#DDE3E8", "role": "borders, dividers" },
    "navyDeep": { "value": "#081F2E", "role": "shadow end of navy gradients" },
    "navyHover": { "value": "#1D4A66", "role": "hover on navy buttons" },
    "amber": { "value": "#EA8007", "role": "active state in demos, logo hover" },
    "focus": { "value": "#2C7BE5", "role": "focus ring" }
  },
  "gradient": {
    "hero": "linear-gradient(180deg, #B9E7FA 0%, #86AFC4 38%, #3A5B71 72%, #0C2B3F 100%)",
    "light": "linear-gradient(180deg, #F3FBFF 0%, #B4E4FA 100%)",
    "navyDepth": "radial-gradient(120% 160% at 80% 30%, #1C4560 0%, #0C2B3F 55%, #081F2E 100%)"
  },
  "font": {
    "family": { "value": "Inter Tight", "fallback": "'Helvetica Neue', Helvetica, Arial, sans-serif", "license": "SIL OFL 1.1" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "type": {
    "hero": { "weight": 600, "size": "clamp(38px, 4.3vw, 68px)", "lineHeight": 0.95, "tracking": "-0.035em", "case": "uppercase" },
    "heroSub": { "weight": 500, "size": "clamp(26px, 2.6vw, 40px)", "lineHeight": 1.05, "tracking": "-0.03em" },
    "hXL": { "weight": 500, "size": "clamp(36px, 4.2vw, 64px)", "lineHeight": 0.98, "tracking": "-0.04em" },
    "hL": { "weight": 500, "size": "clamp(28px, 3vw, 46px)", "lineHeight": 1.02, "tracking": "-0.035em" },
    "hM": { "weight": 500, "size": "clamp(22px, 1.9vw, 28px)", "lineHeight": 1.12, "tracking": "-0.025em" },
    "statement": { "weight": 600, "size": "clamp(24px, 2.1vw, 32px)", "lineHeight": 1.05, "tracking": "-0.03em" },
    "lead": { "weight": 500, "size": "clamp(18px, 1.5vw, 23px)", "lineHeight": 1.35, "tracking": "-0.01em" },
    "body": { "weight": 400, "size": "17px", "lineHeight": 1.45, "tracking": "0" },
    "label": { "weight": 500, "size": "13px", "lineHeight": 1.2, "tracking": "0.06em", "case": "uppercase", "opacity": 0.75 },
    "buttonCaps": { "weight": 700, "size": "15px", "tracking": "0.02em", "case": "uppercase" }
  },
  "space": { "unit": "4px", "scale": [4, 8, 12, 16, 20, 24, 32, 48], "gridGap": { "desktop": "20px", "phone": "12px" }, "tilePadding": { "desktop": "clamp(24px, 3vw, 48px)", "phone": "20px" } },
  "radius": { "tile": "32px", "tilePhone": "22px", "input": "16px", "ctaCard": "18px", "pill": "999px", "tag": "8px", "badge": "6px", "adPreview": "14px" },
  "layout": { "grid": "12 columns, max width 1440px, gutter min 16px", "tiles": "bento of rounded tiles; tones navy, sky, light, gray, white" },
  "motion": {
    "easeIn": "expo.out / power4.out", "easeState": "power2.inOut", "easeWipe": "cubic-bezier(.7,0,.2,1)",
    "durations": { "textBlurIn": "0.16-0.30s", "lineDraw": "0.6s", "panelWipe": "0.6s", "tabSlide": "0.32s", "fadeOut": "0.25s", "ambientLoop": "6-18s" },
    "forbidden": ["bounce", "elastic", "squash", "spinning or tilting the ring"]
  },
  "ads": {
    "margin": "108px at 1080px width",
    "safe": { "vertical": "keep top 250px and bottom 340px clear", "wide": "keep bottom 140px clear" },
    "logoHeight": "about 3% of the shorter side",
    "minTextSize": "28px at 1080px width"
  }
}
